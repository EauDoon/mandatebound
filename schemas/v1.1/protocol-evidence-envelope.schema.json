{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Oonyl/mandatebound/schemas/v1.1/protocol-evidence-envelope.schema.json",
  "title": "ProtocolEvidenceEnvelope",
  "$defs": {
    "mappedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": {
          "$ref": "common.schema.json#/$defs/safePath"
        },
        "digest": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      }
    },
    "mappingStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "ruleId", "inputPointer", "outputPointer", "status"],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4095
        },
        "ruleId": {
          "$ref": "common.schema.json#/$defs/asciiIdentifier"
        },
        "inputPointer": {
          "type": "string",
          "pattern": "^(|/(?:[^~/]|~0|~1)*)$",
          "maxLength": 512
        },
        "outputPointer": {
          "type": "string",
          "pattern": "^(|/(?:[^~/]|~0|~1)*)$",
          "maxLength": 512
        },
        "status": {
          "$ref": "common.schema.json#/$defs/status"
        }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mapperId",
        "mapperVersion",
        "mappingPolicyDigest",
        "inputDigest",
        "outputArtifacts",
        "steps",
        "traceDigest"
      ],
      "properties": {
        "mapperId": {
          "$ref": "common.schema.json#/$defs/asciiIdentifier"
        },
        "mapperVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "maxLength": 32
        },
        "mappingPolicyDigest": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "inputDigest": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "outputArtifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/mappedArtifact"
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/mappingStep"
          }
        },
        "traceDigest": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      }
    },
    "checkpointInclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpointId", "sequence", "leafIndex", "treeSize", "auditPath"],
      "properties": {
        "checkpointId": {
          "$ref": "common.schema.json#/$defs/asciiIdentifier"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "leafIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4095
        },
        "treeSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "auditPath": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "common.schema.json#/$defs/sha256"
          }
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "envelopeId",
    "sourceId",
    "eventClass",
    "capturedAt",
    "mediaType",
    "rawEvidence",
    "upstreamValid",
    "mapping",
    "envelopeDigest"
  ],
  "properties": {
    "format": {
      "const": "MandateBoundProtocolEvidenceEnvelope/v1"
    },
    "envelopeId": {
      "$ref": "common.schema.json#/$defs/asciiIdentifier"
    },
    "sourceId": {
      "$ref": "common.schema.json#/$defs/asciiIdentifier"
    },
    "eventClass": {
      "$ref": "common.schema.json#/$defs/asciiIdentifier"
    },
    "capturedAt": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "mediaType": {
      "$ref": "common.schema.json#/$defs/mediaType"
    },
    "rawEvidence": {
      "$ref": "common.schema.json#/$defs/rawEvidence"
    },
    "upstreamValid": {
      "type": "boolean"
    },
    "mapping": {
      "$ref": "#/$defs/mapping"
    },
    "checkpointInclusion": {
      "$ref": "#/$defs/checkpointInclusion"
    },
    "envelopeDigest": {
      "$ref": "common.schema.json#/$defs/sha256"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Oonyl/mandatebound/schemas/v1.1/case-pack.schema.json",
  "title": "MandateBoundCasePack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "casePackId",
    "createdAt",
    "nativeEvidenceBundle",
    "protocolEvidence",
    "delegationContext",
    "coverageContract",
    "sourceCheckpoints",
    "casePackDigest"
  ],
  "properties": {
    "format": {
      "const": "MandateBoundCasePack/v1"
    },
    "casePackId": {
      "$ref": "common.schema.json#/$defs/asciiIdentifier"
    },
    "createdAt": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "nativeEvidenceBundle": {
      "$ref": "../v1/evidence-bundle.schema.json"
    },
    "protocolEvidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "$ref": "protocol-evidence-envelope.schema.json"
      }
    },
    "externalTrustSnapshot": {
      "$ref": "external-trust-snapshot.schema.json"
    },
    "delegationContext": {
      "$ref": "delegation-context.schema.json"
    },
    "coverageContract": {
      "$ref": "evidence-coverage-contract.schema.json"
    },
    "sourceCheckpoints": {
      "type": "array",
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "$ref": "source-checkpoint.schema.json"
      }
    },
    "casePackDigest": {
      "$ref": "common.schema.json#/$defs/sha256"
    }
  }
}

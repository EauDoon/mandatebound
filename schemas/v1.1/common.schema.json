{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Oonyl/mandatebound/schemas/v1.1/common.schema.json",
  "$defs": {
    "asciiIdentifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "maxLength": 128
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "satisfied",
        "missing",
        "conflicting",
        "unsupported",
        "unknown",
        "not_applicable"
      ]
    },
    "mediaType": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]+$",
      "maxLength": 160
    },
    "safePath": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._/-]{0,239}$",
      "maxLength": 240,
      "not": {
        "pattern": "(^|/)\\.\\.?(/|$)|\\\\|//|/$"
      }
    },
    "rawReference": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["referenceId", "kind", "value"],
          "properties": {
            "referenceId": {
              "$ref": "#/$defs/asciiIdentifier"
            },
            "kind": {
              "const": "bundle_path"
            },
            "value": {
              "$ref": "#/$defs/safePath"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["referenceId", "kind", "value"],
          "properties": {
            "referenceId": {
              "$ref": "#/$defs/asciiIdentifier"
            },
            "kind": {
              "const": "content_addressed"
            },
            "value": {
              "type": "string",
              "pattern": "^urn:sha256:[a-f0-9]{64}$",
              "maxLength": 75
            }
          }
        }
      ]
    },
    "rawEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "byteLength", "reference"],
      "properties": {
        "digest": {
          "$ref": "#/$defs/sha256"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777216
        },
        "reference": {
          "$ref": "#/$defs/rawReference"
        }
      }
    },
    "publicJwk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kty", "crv", "x"],
      "properties": {
        "kty": {
          "const": "OKP"
        },
        "crv": {
          "const": "Ed25519"
        },
        "x": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "alg": {
          "const": "EdDSA"
        },
        "use": {
          "const": "sig"
        },
        "key_ops": {
          "const": ["verify"]
        }
      }
    }
  }
}

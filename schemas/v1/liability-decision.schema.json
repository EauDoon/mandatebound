{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Oonyl/mandatebound/schemas/v1/liability-decision.schema.json",
  "title": "LiabilityDecision",
  "$defs": {
    "factScalar": { "oneOf": [{ "type": "null" }, { "type": "boolean" }, { "type": "string", "maxLength": 256 }, { "type": "integer" }] },
    "conditionTrace": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "operator", "matched"],
      "properties": {
        "path": { "type": "string", "maxLength": 512 },
        "operator": { "enum": ["eq", "in", "all", "any", "not"] },
        "matched": { "type": "boolean" },
        "fact": { "$ref": "common.schema.json#/$defs/asciiIdentifier" },
        "actual": { "$ref": "#/$defs/factScalar" },
        "expected": { "oneOf": [{ "$ref": "#/$defs/factScalar" }, { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/factScalar" } }] }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactId", "caseId", "evaluatedAt", "evidenceBundleId", "evidenceBundleDigest", "policyRef", "rulebookRef", "trustSnapshotRef", "engineVersion", "outcome", "disposition", "policyOutcome", "appealPolicy", "reasonCodes", "trace", "missingEvidence", "conflictingEvidence", "cryptographicFacts", "verifiedFacts", "attributedAttestations", "policyConclusions", "rejectedEvidence", "deterministicTrace", "pins", "externalAuthenticity", "legalEffect"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "artifactId": { "$ref": "common.schema.json#/$defs/asciiIdentifier" },
    "caseId": { "$ref": "common.schema.json#/$defs/asciiIdentifier" },
    "evaluatedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "evidenceBundleId": { "$ref": "common.schema.json#/$defs/asciiIdentifier" },
    "evidenceBundleDigest": { "$ref": "common.schema.json#/$defs/sha256" },
    "policyRef": { "$ref": "common.schema.json#/$defs/artifactRef" },
    "rulebookRef": { "$ref": "common.schema.json#/$defs/artifactRef" },
    "trustSnapshotRef": { "$ref": "common.schema.json#/$defs/artifactRef" },
    "engineVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 32 },
    "outcome": { "enum": ["principal", "operator", "model_vendor", "unresolved"] },
    "disposition": { "enum": ["allocated", "indeterminate", "conflicted", "invalid"] },
    "policyOutcome": { "enum": ["principal", "operator", "model_vendor", "unresolved"] },
    "appealPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["reviewerIds", "maxAppealEvents"],
      "properties": {
        "reviewerIds": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/asciiIdentifier" } },
        "maxAppealEvents": { "type": "integer", "minimum": 0, "maximum": 10000 }
      }
    },
    "allocation": { "$ref": "common.schema.json#/$defs/actorRef" },
    "reasonCodes": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "common.schema.json#/$defs/asciiIdentifier" } },
    "trace": {
      "type": "array", "maxItems": 1024,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["stage", "result", "reasonCode", "artifactRefs"],
        "properties": {
          "stage": { "$ref": "common.schema.json#/$defs/asciiIdentifier" },
          "result": { "enum": ["pass", "fail", "not_applicable", "matched"] },
          "reasonCode": { "$ref": "common.schema.json#/$defs/asciiIdentifier" },
          "artifactRefs": { "type": "array", "maxItems": 128, "items": { "$ref": "common.schema.json#/$defs/artifactRef" } }
        }
      }
    },
    "missingEvidence": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/asciiIdentifier" } },
    "conflictingEvidence": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/asciiIdentifier" } },
    "cryptographicFacts": {
      "type": "array", "maxItems": 4096,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["artifactRef", "purpose", "trustBasis"],
        "properties": {
          "artifactRef": { "$ref": "common.schema.json#/$defs/artifactRef" },
          "proofKid": { "$ref": "common.schema.json#/$defs/keyId" },
          "schemaDigest": { "$ref": "common.schema.json#/$defs/sha256" },
          "purpose": { "oneOf": [{ "$ref": "common.schema.json#/$defs/proofPurpose" }, { "const": "digest_pin" }] },
          "signedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
          "trustBasis": { "enum": ["caller_digest_pin", "pinned_root_and_digest"] }
        }
      }
    },
    "verifiedFacts": {
      "type": "array", "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "value", "sourceRefs"],
        "properties": {
          "name": { "$ref": "common.schema.json#/$defs/asciiIdentifier" },
          "value": { "$ref": "#/$defs/factScalar" },
          "sourceRefs": { "type": "array", "maxItems": 4096, "items": { "$ref": "common.schema.json#/$defs/artifactRef" } }
        }
      }
    },
    "attributedAttestations": {
      "type": "array", "maxItems": 4096,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["artifactRef", "attributedTo", "assertion", "accepted"],
        "properties": {
          "artifactRef": { "$ref": "common.schema.json#/$defs/artifactRef" },
          "attributedTo": { "$ref": "common.schema.json#/$defs/actorRef" },
          "assertion": { "type": "string", "maxLength": 512 },
          "accepted": { "type": "boolean" }
        }
      }
    },
    "policyConclusions": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["reasonCode", "outcome", "disposition"],
        "properties": {
          "ruleId": { "$ref": "common.schema.json#/$defs/asciiIdentifier" },
          "reasonCode": { "$ref": "common.schema.json#/$defs/asciiIdentifier" },
          "outcome": { "enum": ["principal", "operator", "model_vendor", "unresolved"] },
          "disposition": { "enum": ["allocated", "indeterminate", "conflicted", "invalid"] }
        }
      }
    },
    "rejectedEvidence": {
      "type": "array", "maxItems": 4096,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["reasonCode"],
        "properties": {
          "artifactRef": { "$ref": "common.schema.json#/$defs/artifactRef" },
          "reasonCode": { "$ref": "common.schema.json#/$defs/asciiIdentifier" }
        }
      }
    },
    "deterministicTrace": {
      "type": "array", "maxItems": 1024,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["ruleId", "priority", "matched", "conditions"],
        "properties": {
          "ruleId": { "$ref": "common.schema.json#/$defs/asciiIdentifier" },
          "priority": { "type": "integer", "minimum": 0, "maximum": 1000000 },
          "matched": { "type": "boolean" },
          "conditions": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/conditionTrace" } }
        }
      }
    },
    "pins": {
      "type": "object", "additionalProperties": false,
      "required": ["asOf", "policyDigest", "trustSnapshotDigest", "rulebookDigest", "schemaDigests", "engineVersion", "bundleRootDigest"],
      "properties": {
        "asOf": { "$ref": "common.schema.json#/$defs/timestamp" },
        "policyDigest": { "$ref": "common.schema.json#/$defs/sha256" },
        "trustSnapshotDigest": { "$ref": "common.schema.json#/$defs/sha256" },
        "rulebookDigest": { "$ref": "common.schema.json#/$defs/sha256" },
        "schemaDigests": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/sha256" } },
        "engineVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 32 },
        "bundleRootDigest": { "$ref": "common.schema.json#/$defs/sha256" },
        "trustRootKid": { "$ref": "common.schema.json#/$defs/keyId" }
      }
    },
    "externalAuthenticity": { "enum": ["established_by_caller_pins", "unestablished"] },
    "supersedesDecisionId": { "$ref": "common.schema.json#/$defs/asciiIdentifier" },
    "appealId": { "$ref": "common.schema.json#/$defs/asciiIdentifier" },
    "legalEffect": { "const": "not-determined" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Oonyl/mandatebound/schemas/v1/trust-snapshot.schema.json",
  "title": "TrustSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactId", "revision", "issuedAt", "asOf", "issuer", "keys"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "artifactId": { "$ref": "common.schema.json#/$defs/asciiIdentifier" },
    "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "issuedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "asOf": { "$ref": "common.schema.json#/$defs/timestamp" },
    "issuer": { "$ref": "common.schema.json#/$defs/actorRef" },
    "previousSnapshotDigest": { "$ref": "common.schema.json#/$defs/sha256" },
    "keys": {
      "type": "array", "minItems": 1, "maxItems": 4096,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kid", "publicKey", "roles", "purposes", "validFrom", "validUntil", "scopes"],
        "properties": {
          "kid": { "$ref": "common.schema.json#/$defs/keyId" },
          "publicKey": { "$ref": "common.schema.json#/$defs/publicJwk" },
          "roles": { "type": "array", "minItems": 1, "maxItems": 9, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/actorRole" } },
          "purposes": { "type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/proofPurpose" } },
          "validFrom": { "$ref": "common.schema.json#/$defs/timestamp" },
          "validUntil": { "$ref": "common.schema.json#/$defs/timestamp" },
          "invalidFrom": { "$ref": "common.schema.json#/$defs/timestamp" },
          "scopes": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/asciiIdentifier" } }
        }
      }
    }
  }
}

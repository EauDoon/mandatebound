{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Oonyl/mandatebound/schemas/v1.2/ap2-evidence-pack-verification.schema.json",
  "title": "MandateBound AP2 Evidence Pack Verification v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "releaseVersion",
    "status",
    "packDigest",
    "expectedPackDigest",
    "anchorMatched",
    "digestValid",
    "checkoutVersionBinding",
    "revocationCoverage",
    "reportedRevocationState",
    "resolution",
    "issues",
    "legalEffect",
    "reportDigest"
  ],
  "properties": {
    "schemaId": {
      "const": "MandateBoundAp2EvidencePackVerification/v1"
    },
    "releaseVersion": {
      "const": "1.2.0"
    },
    "status": {
      "enum": [
        "verified",
        "unresolved"
      ]
    },
    "packDigest": {
      "oneOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "expectedPackDigest": {
      "oneOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "anchorMatched": {
      "type": "boolean"
    },
    "digestValid": {
      "type": "boolean"
    },
    "checkoutVersionBinding": {
      "enum": [
        "matched",
        "missing",
        "conflicting"
      ]
    },
    "revocationCoverage": {
      "enum": [
        "provided",
        "missing"
      ]
    },
    "reportedRevocationState": {
      "enum": [
        "not_revoked",
        "revoked",
        "unknown"
      ]
    },
    "resolution": {
      "oneOf": [
        {
          "$ref": "ap2-dispute-evidence-resolution.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "issues": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "legalEffect": {
      "const": "not-determined"
    },
    "reportDigest": {
      "$ref": "#/$defs/digest"
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "verified"
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "packDigest": {
            "$ref": "#/$defs/digest"
          },
          "expectedPackDigest": {
            "$ref": "#/$defs/digest"
          },
          "anchorMatched": {
            "const": true
          },
          "digestValid": {
            "const": true
          },
          "checkoutVersionBinding": {
            "const": "matched"
          },
          "revocationCoverage": {
            "const": "provided"
          },
          "reportedRevocationState": {
            "const": "not_revoked"
          },
          "resolution": {
            "allOf": [
              {
                "$ref": "ap2-dispute-evidence-resolution.schema.json"
              },
              {
                "type": "object",
                "required": [
                  "status"
                ],
                "properties": {
                  "status": {
                    "const": "evidence_verified"
                  }
                }
              }
            ]
          },
          "issues": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "path",
        "message",
        "impact",
        "sourceRefs"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "impact": {
          "enum": [
            "missing",
            "conflicting",
            "invalid",
            "unsupported",
            "retrieval",
            "eligibility"
          ]
        },
        "sourceRefs": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          }
        }
      }
    }
  }
}

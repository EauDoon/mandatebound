root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
# scripts/lint.mjs reports trailing whitespace on every tracked text file,
# markdown included, so keep this true. With it false an editorconfig-aware
# editor leaves the whitespace in place and CI then rejects the commit that
# the editor declined to clean up.
trim_trailing_whitespace = true
